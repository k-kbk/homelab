---
upstreams:
  groups:
    default:
{% for upstream in blocky_upstreams %}
      - {{ upstream | to_json }}
{% endfor %}
  strategy: {{ blocky_upstream_strategy | to_json }}
  timeout: 2s

bootstrapDns:
{% for resolver in blocky_bootstrap_dns %}
  - upstream: {{ resolver.upstream | to_json }}
    ips:
{% for ip in resolver.ips %}
      - {{ ip | to_json }}
{% endfor %}
{% endfor %}

dnssec:
  validate: true

rebindingProtection:
  enable: true

rateLimit:
  enable: true
  rate: 50
  burst: 100

blocking:
  denylists:
    ads:
{% for url in blocky_blocklists %}
      - {{ url | to_json }}
{% endfor %}
  clientGroupsBlock:
    default:
      - ads
  blockType: zeroIp
  loading:
    refreshPeriod: {{ blocky_refresh_period | to_json }}

caching:
  minTime: "0m"
  maxTime: {{ blocky_cache_max_time | to_json }}
  maxItemsCount: {{ blocky_cache_max_items }}

customDNS:
  customTTL: {{ blocky_custom_dns_ttl | to_json }}
  filterUnmappedTypes: true
  mapping:
{% for service_name in blocky_service_names | sort %}
    {{ (service_name ~ '.' ~ blocky_internal_domain) | to_json }}: {{ gateway_vip | to_json }}
{% endfor %}
{% for node_name, node_ip in node_ips | dictsort %}
    {{ (node_name ~ '.' ~ blocky_internal_domain) | to_json }}: {{ node_ip | to_json }}
{% endfor %}

ports:
  dns: {{ (ansible_host ~ ':53') | to_json }}

log:
  level: info
  format: text
  privacy: true
